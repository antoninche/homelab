#!/usr/bin/env python3
# Copie la dernière sauvegarde automatique de Home Assistant (faite par HA chaque nuit à 3 h, chiffrée)
# dans le dossier de sauvegarde du Pi. Usage : homelab-sauvegarde-ha <fichier de sortie>
# La clé de déchiffrement est dans /etc/homelab/secrets/ha_backup_key ; le Pi joint la VM par 10.99.0.10.
import json, sys, urllib.request
import websocket

HA = "10.99.0.10"
jeton = open("/etc/homelab/secrets/ha_token").read().strip()
ws = websocket.create_connection(f"ws://{HA}/api/websocket", timeout=60)
ws.recv()
ws.send(json.dumps({"type": "auth", "access_token": jeton}))
if json.loads(ws.recv()).get("type") != "auth_ok":
    sys.exit("authentification refusée par Home Assistant")
ws.send(json.dumps({"id": 1, "type": "backup/info"}))
sauvegardes = json.loads(ws.recv())["result"]["backups"]
auto = [b for b in sauvegardes if b.get("with_automatic_settings")]
if not auto:
    sys.exit("aucune sauvegarde automatique dans Home Assistant")
derniere = max(auto, key=lambda b: b["date"])
url = f"http://{HA}/api/backup/download/{derniere['backup_id']}?agent_id=hassio.local"
requete = urllib.request.Request(url, headers={"Authorization": "Bearer " + jeton})
with urllib.request.urlopen(requete, timeout=900) as reponse, open(sys.argv[1], "wb") as sortie:
    while bloc := reponse.read(1 << 20):
        sortie.write(bloc)
print(f"{derniere['date'][:16]} · {derniere['backup_id']}")
